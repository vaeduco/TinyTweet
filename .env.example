# Copy to .env.local and fill in your Supabase project values.
# Project Settings → API in the Supabase dashboard.

# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only — never exposed to the browser. Optional (not used by the app itself).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server only — GIF search (message + reply composers). Get a key at
# https://developers.giphy.com. GIF search is disabled until this is set.
GIPHY_API_KEY=your-giphy-api-key

# Public — Web Push VAPID public key (browser subscribe). Generate a pair with
# `npx web-push generate-vapid-keys`; put the public half here and the private
# half in the push-notify Edge Function's secrets. Push is disabled until set.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
